PORT=5000
FRONTEND_URL=http://localhost:8080

# MongoDB
MONGO_URI=mongodb://localhost:27017/sentinelai

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Groq API Keys (comma-separated for fallback)
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2

# Gemini API Keys (comma-separated for fallback)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Legacy single key (kept for backward compatibility)
GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# Web Push Notifications (Generate with: npm run generate:vapid)
VAPID_PUBLIC_KEY=your_generated_public_key
VAPID_PRIVATE_KEY=your_generated_private_key

# WhatsApp Notifications (Optional - Using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_CONTENT_SID=your_twilio_content_template_sid
