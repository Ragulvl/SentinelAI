PORT=5000
NODE_ENV=production

# ── Frontend URL (your Vercel deployment URL) ──────────────────────────────
# Replace with your actual Vercel URL after first deploy
FRONTEND_URL=https://sentinalsec.vercel.app

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Get free cluster at: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinelai
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sentinelai?retryWrites=true&w=majority

# ── GitHub OAuth App ───────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New
# Homepage URL:         https://sentinalsec.vercel.app
# Authorization Callback: https://sentinalsec.vercel.app/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://sentinalsec.vercel.app/api/auth/github/callback

# ── AI API Keys ────────────────────────────────────────────────────────────
# Groq (free): https://console.groq.com/keys
# Gemini (free): https://aistudio.google.com/apikey
# Use comma-separated values for multiple keys (automatic fallback)
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# Legacy single key (optional, kept for backward compatibility)
GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── Web Push Notifications (Optional) ─────────────────────────────────────
# Generate keys by running: npm run generate:vapid (inside /backend)
VAPID_PUBLIC_KEY=your_generated_vapid_public_key
VAPID_PRIVATE_KEY=your_generated_vapid_private_key

# ── WhatsApp / Twilio (Optional) ──────────────────────────────────────────
# Required only if you want WhatsApp alert notifications
# Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_CONTENT_SID=your_twilio_content_template_sid
